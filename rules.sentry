# ==========================================================
# SentryScript detection policy for our login system
# Home country: PK
# ==========================================================

# ----- Lists used by the rules below ----------------------
# Define a list once with "let", then test against it with "in" / "not in".

# Accounts worth protecting most
let privileged_accounts = ["admin", "root"]

# Addresses we trust for administrator logins. Update when they change.
let trusted_admin_ips = ["172.16.0.7", "172.16.0.8"]

# Accounts used by scheduled jobs, which are expected to work at night
let service_accounts = ["backup"]


# ----- Password guessing ----------------------------------

# Fast guessing from abroad: 5 failed logins from one IP within 2 minutes.
# Home-country traffic is excluded here and handled by the next rule.
# Blocks the source address (simulated).
rule brute_force {
  severity: high
  when failed_login from ip count >= 5 within 2m and country != "PK"
  then alert "Brute force from {ip} ({country})"
       block ip for 30m
}

# Guessing from inside the home country. The threshold is higher (8) because
# staff mistype passwords more often than attackers abroad do.
# Alert only: no block, since the source may be a real employee.
rule home_country_guessing {
  severity: medium
  when failed_login from ip count >= 8 within 2m and country == "PK"
  then alert "Repeated failures from {ip} inside the home country"
}

# Fast guessing aimed at a privileged account, from any country.
# Stricter window (1 minute) because these accounts are the most valuable targets.
rule admin_targeted {
  severity: critical
  when failed_login from ip count >= 5 within 1m and user in privileged_accounts
  then alert "Privileged account {user} targeted from {ip}"
}


# ----- Suspicious admin activity --------------------------

# Admin actions outside working hours (08:00 to 18:00),
# except scheduled jobs, which run at night on purpose.
rule off_hours_admin {
  severity: medium
  when admin_action at time not in 08:00..18:00 and user not in service_accounts
  then alert "Off-hours admin action by {user}"
}

# A successful login to a privileged account from an address we don't trust.
# "count >= 1" means any single event.
rule unknown_admin_login {
  severity: high
  when login from ip count >= 1 within 1m and user in privileged_accounts and ip not in trusted_admin_ips
  then alert "Admin login from unfamiliar address {ip}"
}