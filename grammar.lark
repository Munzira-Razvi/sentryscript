start: rule+

rule: "rule" CNAME "{" severity? when_clause then_clause "}"

severity: "severity" ":" CNAME

when_clause: "when" CNAME "from" CNAME "count" ">=" INT "within" duration
then_clause: "then" action+

?action: alert_action | block_action
alert_action: "alert" ESCAPED_STRING
block_action: "block" CNAME "for" duration

duration: INT UNIT
UNIT: /[smh]/

COMMENT: /#[^\n]*/

%import common.CNAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
%ignore COMMENT