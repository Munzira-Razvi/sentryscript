start: (let_stmt | rule)+

let_stmt: "let" CNAME "=" list_lit
list_lit: "[" (value ("," value)*)? "]"
value: ESCAPED_STRING | INT

rule: "rule" CNAME "{" severity? when_clause then_clause "}"

severity: "severity" ":" CNAME

?when_clause: count_when | time_when
count_when: "when" CNAME "from" CNAME "count" ">=" INT "within" duration filters
time_when: "when" CNAME "at" "time" negate? "in" TIME ".." TIME filters
negate: "not"

filters: ("and" filter)*
filter: CNAME OP value                 -> compare_filter
      | CNAME "in" membership          -> in_filter
      | CNAME "not" "in" membership    -> not_in_filter
membership: CNAME | list_lit

then_clause: "then" action+

?action: alert_action | block_action
alert_action: "alert" ESCAPED_STRING
block_action: "block" CNAME "for" duration

duration: INT UNIT
UNIT: /[smh]/
TIME: /\d\d:\d\d/
OP: "==" | "!="

COMMENT: /#[^\n]*/

%import common.CNAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
%ignore COMMENT